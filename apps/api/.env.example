# ==============================================================================
# NAidioma — 100% Online na Nuvem (NexaCloud + Cloudflare Encrypted Sync + IA + Stripe)
# Zero Neon (sem risco de bloqueio por limite de horas de computação).
# ==============================================================================
PORT=3000
HOST=0.0.0.0
SERVE_WEB_DIST="true"
APP_PUBLIC_URL="https://naidioma.nexaclouds.online"

# Banco em nuvem com replicação automática AES-256-GCM para Cloudflare (NexaCloud Private KV)
DATABASE_URL="file:/app/data/naidioma.db"
CLOUD_SYNC_URL="https://app.nexaclouds.online/api/customer/projects/naidioma/kv"
CLOUD_SYNC_TOKEN=""

# Segurança (obrigatório gerar chaves fortes e únicas em produção)
JWT_SECRET="GERAR_CHAVE_ALEATORIA_64_CHARS"
ADMIN_API_KEY="GERAR_CHAVE_ADMIN_FORTE"

# Fase Beta 100% Gratuita -> Stripe pronto porém oculto até liberação
FREE_BETA_MODE="true"
BILLING_UI_ENABLED="false"
DAILY_FREE_AI_TURNS="60"

# Stripe (100% conectado — invisível enquanto BILLING_UI_ENABLED="false")
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# E-mail Profissional (Resend ou Brevo)
EMAIL_FROM="NAidioma <contato@naidioma.com.br>"
RESEND_API_KEY=""
BREVO_API_KEY=""

# IA 100% na Nuvem: Ollama Cloud (Inkling 2 Small — só ativar após benchmark de 20 turnos) -> Fallback automático 24/7 no Gemini
# Quando aprovado no benchmark: OLLAMA_BASE_URL="https://ollama.com" e OLLAMA_API_KEY=<secret>
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
OLLAMA_MODEL="inkling-2-small"
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Controle de atualização (Web PWA + Android + Apple iOS)
APP_VERSION="1.0.0"
MIN_SUPPORTED_VERSION="1.0.0"
ANDROID_STORE_URL=""
IOS_STORE_URL=""

CORS_ORIGINS="https://naidioma.nexaclouds.online,https://naidioma.com.br,capacitor://localhost,https://localhost"
