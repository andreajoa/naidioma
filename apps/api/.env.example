# ==============================================================================
# NAidioma — Configuração 100% Online (NexaCloud + PostgreSQL + IA + Stripe)
# Configure estas variáveis no painel de ambiente do NexaCloud.
# NUNCA commite seu arquivo .env real no GitHub!
# ==============================================================================
PORT=3000
HOST=0.0.0.0
SERVE_WEB_DIST="true"
APP_PUBLIC_URL="https://naidioma.com.br"

# Banco de Dados 100% em Nuvem (PostgreSQL — NexaCloud / Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/naidioma?sslmode=require"

# Segurança (obrigatório gerar chaves fortes e únicas em produção)
JWT_SECRET="GERAR_CHAVE_ALEATORIA_64_CHARS"
ADMIN_API_KEY="GERAR_CHAVE_ADMIN_FORTE"

# ==============================================================================
# FASE BETA 100% GRATUITA -> COBRANÇA STRIPE PRONTA PORÉM OCULTA
# Quando quiser liberar os planos pagos no app, basta mudar:
#   BILLING_UI_ENABLED="true"
#   FREE_BETA_MODE="false"
# (ou ativar com 1 clique no Painel Admin)
# ==============================================================================
FREE_BETA_MODE="true"
BILLING_UI_ENABLED="false"
DAILY_FREE_AI_TURNS="60"

# ==============================================================================
# STRIPE (100% conectado — pronto para ativação imediata)
# ==============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# ==============================================================================
# E-MAIL PROFISSIONAL (Boas-vindas & Mailing NAidioma)
# ==============================================================================
EMAIL_FROM="NAidioma <contato@naidioma.com.br>"
RESEND_API_KEY=""
BREVO_API_KEY=""

# ==============================================================================
# IA 100% NA NUVEM (Prioridade 1: Ollama Cloud / Kaggle T4 x2 -> Fallback 24/7)
# ==============================================================================
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
OLLAMA_MODEL="gpt-oss:20b"

OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# CONTROLE DE ATUALIZAÇÃO DO APP (Web + Android + Apple iOS)
# ==============================================================================
APP_VERSION="1.0.0"
MIN_SUPPORTED_VERSION="1.0.0"
ANDROID_STORE_URL=""
IOS_STORE_URL=""

CORS_ORIGINS="https://naidioma.com.br,https://www.naidioma.com.br,capacitor://localhost,https://localhost"
