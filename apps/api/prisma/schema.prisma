generator client {
  provider = "prisma-client-js"
}

// Cloud-persisted SQLite (WAL) inside NexaCloud container with automatic
// AES-256-GCM encrypted replication to Cloudflare (NexaCloud Private KV).
// Zero Neon compute-hour lockouts, zero external DB ceilings.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  displayName           String
  whatsapp              String?
  role                  String    @default("user") // user | admin
  activeLanguage        String    @default("en")
  dailyGoalMinutes      Int       @default(10)
  xpTotal               Int       @default(0)
  streakDays            Int       @default(0)
  longestStreak         Int       @default(0)
  lastStudyDate         String?   // YYYY-MM-DD

  // Location & Device Telemetry (auto-detected via Cloudflare/IP or optionally declared by user)
  city                  String?
  region                String?
  country               String?
  timezone              String?
  locationSource        String?   // user | cloudflare | ip
  visitorId             String?

  // Active Usage Telemetry
  totalTimeSeconds      Int       @default(0)
  sessionsCount         Int       @default(0)
  lastActiveAt          DateTime?
  lastPlatform          String?   // web | pwa | android | ios
  lastDeviceType        String?   // mobile | tablet | desktop
  lastOs                String?
  lastBrowser           String?
  pwaInstalled          Boolean   @default(false)
  calmModeEnabled       Boolean   @default(false)
  soundEnabled          Boolean   @default(true)

  // Mailing & Email Marketing (LGPD compliant)
  marketingOptIn        Boolean   @default(true)
  marketingOptInAt      DateTime?
  leadSource            String    @default("nucleoafetar")
  utmCampaign           String?
  welcomeEmailSent      Boolean   @default(false)

  // Monetization & Stripe (Hidden in UI until BILLING_UI_ENABLED=true)
  subscriptionTier      String    @default("free") // free | plus | pro
  subscriptionPlanKey   String?
  subscriptionProvider  String?   // stripe | apple_iap | google_play
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionExpiresAt DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lessonProgress        LessonProgress[]
  skillScores           SkillScore[]
  fsrsCards             FsrsCard[]
  conversations         ConversationSession[]
  feedbacks             BetaFeedback[]
  aiUsage               AiUsageDaily[]
  pushSubscriptions     PushSubscription[]
  visitorSessions       VisitorSession[]
  analyticsEvents       AnalyticsEvent[]

  @@index([marketingOptIn, activeLanguage])
  @@index([leadSource, createdAt])
  @@index([country, region, city])
  @@index([lastActiveAt])
  @@index([createdAt])
}

model LessonProgress {
  id                   String   @id @default(cuid())
  userId               String
  language             String
  lessonId             String
  bestAccuracy         Int      @default(0)
  lastAccuracy         Int      @default(0)
  xpEarned             Int      @default(0)
  completedCount       Int      @default(1)
  totalDurationSeconds Int      @default(0)
  lastDurationSeconds  Int      @default(0)
  completedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, language])
  @@index([language, bestAccuracy])
  @@index([completedAt])
}

model SkillScore {
  id         String   @id @default(cuid())
  userId     String
  language   String
  speaking   Int      @default(10)
  listening  Int      @default(10)
  reading    Int      @default(10)
  writing    Int      @default(10)
  vocabulary Int      @default(10)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

model FsrsCard {
  id            String    @id @default(cuid())
  userId        String
  language      String
  cardId        String
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         String    @default("new") // new | learning | review | relearning
  dueAt         DateTime  @default(now())
  lastReviewAt  DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, language, dueAt])
}

model ConversationSession {
  id             String   @id @default(cuid())
  userId         String
  language       String
  scenarioId     String
  messagesJson   String   @default("[]")
  turnsCount     Int      @default(0)
  avgNaturalness Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, language])
}

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String?
  platform  String   @default("web") // web | android | ios
  category  String   @default("ux") // bug | translation | audio | ux | idea
  language  String?
  route     String?
  lessonId  String?
  message   String
  userAgent String?
  status    String   @default("new") // new | in_progress | resolved
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AiUsageDaily {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String   // YYYY-MM-DD
  turnsUsed Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

model RuntimeConfig {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  reminderHour   Int      @default(18)
  timezoneOffset Int      @default(-3)
  petName        String   @default("Puzinho")
  active         Boolean  @default(true)
  lastSentDate   String?  // YYYY-MM-DD
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model VisitorSession {
  id                String   @id @default(cuid())
  visitorId         String
  userId            String?
  startedAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  durationSeconds   Int      @default(0)
  entryPath         String   @default("/")
  lastPath          String   @default("/")
  referrer          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  platform          String   @default("web") // web | pwa | android | ios
  deviceType        String   @default("desktop") // mobile | tablet | desktop
  os                String?
  browser           String?
  screenWidth       Int?
  screenHeight      Int?
  pwaInstalled      Boolean  @default(false)
  city              String?
  region            String?
  country           String?
  timezone          String?
  ipHash            String?
  activeLanguage    String?
  screensJson       String   @default("{}")
  eventsCount       Int      @default(1)
  convertedToSignup Boolean  @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId, startedAt])
  @@index([userId, startedAt])
  @@index([country, region, city])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String?
  userId    String?
  eventType String
  language  String?
  cefr      String?
  lessonId  String?
  screen    String?
  valueNum  Int?
  metaJson  String?
  city      String?
  country   String?
  platform  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([language, createdAt])
  @@index([createdAt])
}

model SavedReport {
  id          String    @id @default(cuid())
  title       String
  periodType  String    @default("30d") // 7d | 30d | 90d | all | custom
  periodStart DateTime
  periodEnd   DateTime
  summaryJson String
  notes       String?
  emailedTo   String?
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  ipHash    String?
  city      String?
  country   String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}
